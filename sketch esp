// ==================== Server Handlers ====================

void handleRoot() {
  server.send(200, "text/html", html);
}

void handleCommand() {
  String cmd = server.arg("t");
  cmd.trim();
  cmd.toUpperCase();
  Serial.print(">> CMD: ");
  Serial.println(cmd);
  processCommand(cmd);
  server.send(200, "text/plain", "OK");
}

void handlePosition() {
  String pos = "M1=" + String(motor1Position) + ", M2=" + String(motor2Position);
  server.send(200, "text/plain", pos.c_str());
}

void calcPath() {
  for (int i = 0; i < 6; i++) {
    float t = (float)i / 5.0;
    dynPosM1[i] = pointA_M1 + (long)((pointB_M1 - pointA_M1) * t);
    dynPosM2[i] = pointA_M2 + (long)((pointB_M2 - pointA_M2) * t);
  }
  pathCalculated = true;
  Serial.println("Path calculated:");
  for(int i=0; i<6; i++) Serial.printf("  P%d: M1=%ld, M2=%ld\n", i+1, dynPosM1[i], dynPosM2[i]);
}

// ==================== Stepper Control ====================

void moveMotor(int sp, int dp, int dir, int steps, int dly, int num) {
  Serial.print("Moving M"); Serial.print(num); Serial.print(" ");
  Serial.println(dir == FORWARD ? "FWD" : "REV");
  digitalWrite(dp, dir);
  for (int i = 0; i < steps; i++) {
    if (stopRequested) {
      Serial.println("Stopped");
      digitalWrite(MOTOR1_STEP, LOW); digitalWrite(MOTOR2_STEP, LOW);
      stopRequested = false; return;
    }
    server.handleClient();
    digitalWrite(sp, HIGH); delay(dly);
    digitalWrite(sp, LOW); delay(dly);
    if (num == 1) motor1Position += (dir == FORWARD) ? 1 : -1;
    else motor2Position += (dir == FORWARD) ? 1 : -1;
  }
  Serial.println("Done");
}

void moveBothMotors(int sp1, int dp1, int sp2, int dp2, int dir, int steps, int dly) {
  Serial.print("Moving BOTH motors "); Serial.println(dir == FORWARD ? "FWD" : "REV");
  digitalWrite(dp1, dir); digitalWrite(dp2, dir);
  for (int i = 0; i < steps; i++) {
    if (stopRequested) {
      Serial.println("BOTH Stopped");
      digitalWrite(MOTOR1_STEP, LOW); digitalWrite(MOTOR2_STEP, LOW);
      stopRequested = false; return;
    }
    server.handleClient();
    digitalWrite(sp1, HIGH); digitalWrite(sp2, HIGH); delay(dly);
    digitalWrite(sp1, LOW); digitalWrite(sp2, LOW); delay(dly);
    motor1Position += (dir == FORWARD) ? 1 : -1;
    motor2Position += (dir == FORWARD) ? 1 : -1;
  }
  Serial.println("BOTH Done");
}

void moveToAbsolute(int sp, int dp, long target, int num) {
  long current = (num == 1) ? motor1Position : motor2Position;
  long diff = target - current;
  if (diff == 0) { Serial.print("M"); Serial.print(num); Serial.println(" already at target"); return; }
  int dir = (diff > 0) ? FORWARD : BACKWARD;
  int steps = (diff > 0) ? diff : -diff;
  Serial.print("M"); Serial.print(num); Serial.print(" -> Target: "); 
  Serial.print(target); Serial.print(" (Steps: "); Serial.print(steps); Serial.println(")");
  moveMotor(sp, dp, dir, steps, globalStepDelay, num);
}

void returnToHome(int num) {
  long pos = (num == 1) ? motor1Position : motor2Position;
  if (pos == 0) { Serial.print(" M"); Serial.print(num); Serial.println(" already at home"); return; }
  int steps = abs(pos);
  int dir = (pos > 0) ? BACKWARD : FORWARD;
  int sp = (num == 1) ? MOTOR1_STEP : MOTOR2_STEP;
  int dp = (num == 1) ? MOTOR1_DIR : MOTOR2_DIR;
  Serial.print("Returning M"); Serial.print(num); Serial.print(" to home (");
  Serial.print(steps); Serial.println(" steps)");
  digitalWrite(dp, dir);
  for (int i = 0; i < steps; i++) {
    if (stopRequested) {
      Serial.println("Stopped returning");
      digitalWrite(MOTOR1_STEP, LOW); digitalWrite(MOTOR2_STEP, LOW);
      stopRequested = false; return;
    }
    server.handleClient();
    digitalWrite(sp, HIGH); delay(globalStepDelay);
    digitalWrite(sp, LOW); delay(globalStepDelay);
  }
  if (num == 1) motor1Position = 0; else motor2Position = 0;
}

